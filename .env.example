# ============================================================
# .env.example — Copy this to .env and fill in your values
# ============================================================

# -----------------------------------------------
# Anthropic Claude API
# -----------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------
# Wireless ADB (devcontainer connects directly to device over WiFi)
# Set REMOTE_ADB=true and list your device(s) as ip:port pairs.
# Default ADB WiFi port is 5555. Use 'adb tcpip 5555' on the device first,
# or enable Wireless Debugging in Developer Options (Android 11+).
# -----------------------------------------------
REMOTE_ADB=true
ANDROID_DEVICES=192.168.1.100:5555
# ANDROID_DEVICES=192.168.1.100:5555,192.168.1.101:5555  # multiple devices
REMOTE_ADB_POLLING_SEC=5

# -----------------------------------------------
# Appium Server
# -----------------------------------------------
APPIUM_HOST=localhost
APPIUM_PORT=4723

# -----------------------------------------------
# Android Device Capabilities
# For wireless ADB the UDID is the device's ip:port shown by: adb devices
# Example: 192.168.1.100:5555
# Get Chrome version: adb shell dumpsys package com.android.chrome | grep versionName
# -----------------------------------------------
DEVICE_UDID=192.168.1.100:5555
DEVICE_NAME=Android Device
PLATFORM_VERSION=14.0
CHROME_DRIVER_VERSION=

# -----------------------------------------------
# Test Configuration
# -----------------------------------------------
TARGET_URL=https://example.com
SEARCH_QUERY=example website
SCROLL_PAUSE_SECONDS=1.5
MAX_SCROLL_ATTEMPTS=20
SCREENSHOT_DIR=screenshots
IMPLICIT_WAIT_SECONDS=10
